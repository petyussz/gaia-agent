# Copy to `.env` and adjust. Never commit `.env`.
# NOTE: none of these use a VITE_ prefix, so none of them can be inlined into the client bundle.

# --- Server -------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8788

# --- Ollama -------------------------------------------------------------------------------
# Same wiring as the sibling generative-storyteller deployment: the container reaches Ollama
# on the Docker host via host.docker.internal (mapped to host-gateway in docker-compose.yml).
# Outside Docker, use http://127.0.0.1:11434.
OLLAMA_URL=http://host.docker.internal:11434

# Default model. Blank = first model reported by Ollama.
GAIA_MODEL=

# --- Access control -----------------------------------------------------------------------
# Shared secret. Leave blank to disable auth (a loud warning is logged at boot).
# Your firewall decides which machines can reach the port; this decides who may drive the agent.
# Generate one: openssl rand -hex 24
GAIA_ACCESS_TOKEN=

# --- Persona ------------------------------------------------------------------------------
# Editable persona file. Tool descriptions are appended at runtime from the enabled tool set.
GAIA_SYSTEM_PROMPT_PATH=./system_prompt.md

# --- Session memory -----------------------------------------------------------------------
GAIA_DATA_DIR=./data
# Number of past messages replayed to the model (system prompt is always prepended on top).
GAIA_HISTORY_WINDOW=24

# --- Tools --------------------------------------------------------------------------------
# Comma-separated. Available: get_date, get_weather, search_web
GAIA_TOOLS=get_date,get_weather,search_web
# Required only for search_web. Server-side only — never reaches the browser.
FIRECRAWL_API_KEY=
